# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# --- the event -------------------------------------------------------------
MERCY_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
GAME_MINUTES=25
# 1 = the old single-player mode on the public schema, no lobby login (development only)
MERCY_SINGLE_PLAYER=0

# --- MERCY's brain: Gemini on Google Cloud Vertex AI -------------------------
# stub = canned replies, no model; vertex = Gemini
MERCY_LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=zinnia-mercy
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
# Only when NOT running on a Compute Engine VM with a service account:
# mount a key file (see the commented volume on mercy-engine) and point at it.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json
